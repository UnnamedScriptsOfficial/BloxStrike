local ShotFeed = { node = nil, original = nil, hook = nil }
do
    pcall(function()
        local remotes = require(Replicated.Database.Security.Remotes)
        local node = remotes.Inventory.ShootWeapon
        local original = node.Send

        local function hook(packet, ...)
            pcall(function()
                if not Runtime.active or type(packet) ~= "table" then return end
                local bullets = packet.Bullets
                if type(bullets) ~= "table" then return end

                for _, bullet in ipairs(bullets) do
                    local origin = bullet.Origin
                    local hits = type(bullet.Hits) == "table" and bullet.Hits or {}

                    if CFG.bulletTrace and typeof(origin) == "Vector3" then
                        local last = hits[#hits]
                        local finish = last and last.Position
                        if typeof(finish) == "Vector3" then
                            Tracer.fire(origin, finish, (finish - origin).Magnitude)
                        elseif typeof(bullet.Direction) == "Vector3" then
                            Tracer.fire(origin, bullet.Direction, 500)
                        end
                    end

                    if CFG.hitSound then
                        local landed, headshot = false, false
                        for _, entry in ipairs(hits) do
                            local head = Target.classify(entry.Instance)
                            if head ~= nil then
                                landed = true
                                if head then headshot = true end
                            end
                        end
                        if landed and Target.wants(CFG.hitWhere, headshot) then HitSound.play() end
                    end

                    if CFG.bulletImpacts then pcall(Impacts.record, hits) end
                end
            end)

            return original(packet, ...)
        end

        node.Send = hook
        ShotFeed.node, ShotFeed.original, ShotFeed.hook = node, original, hook
    end)

    function ShotFeed.restore()
        if ShotFeed.node and ShotFeed.original and ShotFeed.node.Send == ShotFeed.hook then
            pcall(function() ShotFeed.node.Send = ShotFeed.original end)
        end
    end
end

local Bhop = { owner = nil, original = nil, hook = nil }
do
    local movement

    pcall(function()
        local localChar = require(Replicated.Controllers.CharacterController.LocalCharacter)
        movement = localChar.getCurrentCharacter

        if not table.isfrozen(localChar) and type(localChar.jump) == "function" then
            local original = localChar.jump
            local function hook(held, ...)
                if held == true then
                    Runtime.jumpHeld = true
                elseif held == false then
                    Runtime.jumpHeld = false
                end
                return original(held, ...)
            end
            localChar.jump = hook
            Bhop.owner, Bhop.original, Bhop.hook = localChar, original, hook
        end
    end)

    local key = Enum.KeyCode.Space
    pcall(function()
        local data = require(Replicated.Controllers.DataController)
        local settings = data.Get(LocalPlayer, "Settings.Keyboard/Mouse")
        settings = type(settings) == "table" and settings["Movement Keys"]
        settings = type(settings) == "table" and settings.Jump
        settings = type(settings) == "table" and settings.Computer
        local name = type(settings) == "string" and settings:match("KeyCode%.([%w_]+)")
        if name and Enum.KeyCode[name] then key = Enum.KeyCode[name] end
    end)

    local function wantsJump()
        if UserInput:IsKeyDown(key) then return true end
        if not (UserInput.GamepadEnabled or UserInput.TouchEnabled) then return false end
        return Runtime.jumpHeld
    end

    function Bhop.release()
        if not movement then return end
        pcall(function()
            local state = movement()
            if type(state) == "table" then state.JumpInputDown = wantsJump() end
        end)
    end

    function Bhop.restore()
        if Bhop.owner and Bhop.original and Bhop.owner.jump == Bhop.hook then
            pcall(function() Bhop.owner.jump = Bhop.original end)
        end
    end

    local engaged = false

    bind(RunService.Heartbeat, function()
        if not (Runtime.active and CFG.autoBhop and movement) then
            if engaged then
                engaged = false
                Bhop.release()
            end
            return
        end
        engaged = true

        local ok, state = pcall(movement)
        if not (ok and type(state) == "table") then return end
        if not wantsJump() then return end

        state.JumpInputDown = false
        if state.OnGround then state.JumpPulsePending = true end
    end)
end

