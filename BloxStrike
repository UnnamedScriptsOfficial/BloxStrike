local Target = {}
do
    local NOT_DAMAGE = { CameraPart = true }

    function Target.character(player)
        local char = player.Character or Characters:FindFirstChild(player.Name)
        if not char or char.Parent ~= Characters then return nil end
        if char:GetAttribute("Dead") then return nil end
        local hp = char:GetAttribute("Health")
        if typeof(hp) == "number" and hp <= 0 then return nil end
        if player:GetAttribute("IsSpectating") then return nil end
        return char
    end

    function Target.isEnemy(player)
        local mine, theirs = LocalPlayer:GetAttribute("Team"), player:GetAttribute("Team")
        if not PLAYING[mine] then return true end
        if not PLAYING[theirs] then return false end
        return theirs ~= mine
    end

    function Target.classify(instance)
        if typeof(instance) ~= "Instance" or not instance:IsA("BasePart") then return nil end
        if NOT_DAMAGE[instance.Name] then return nil end
        local model = instance.Parent
        if not (model and model:IsA("Model") and model.Parent == Characters) then return nil end
        if model == LocalPlayer.Character or model:GetAttribute("Dead") then return nil end
        return instance.Name == "Head"
    end

    function Target.wants(scope, headshot)
        if scope == "Head only" then return headshot end
        if scope == "Body only" then return not headshot end
        return true
    end
end

local Highlight = {}
do
    local host = own(mk("Folder", { Name = suffix("HL_") }, GuiHost))
    local marks = {}

    local function bandColor(alpha)
        return HEALTH_BANDS[math.clamp(math.ceil(alpha * 10), 1, 10)]
    end

    local function drop(player)
        local mark = marks[player]
        if not mark then return end
        if mark.hl then mark.hl:Destroy() end
        marks[player] = nil
    end

    local function inRange(char)
        if CFG.maxDistance <= 0 then return true end
        local camera = workspace.CurrentCamera
        local root = char:FindFirstChild("HumanoidRootPart")
        if not camera or not root then return true end
        return (camera.CFrame.Position - root.Position).Magnitude <= CFG.maxDistance
    end

    local function colorFor(player, char)
        if CFG.colorMode == "Team" then
            return TEAM_COLOR[player:GetAttribute("Team")] or PALETTE[CFG.colorName]
        elseif CFG.colorMode == "Health" then
            local hp = tonumber(char:GetAttribute("Health")) or 100
            local max = tonumber(char:GetAttribute("MaxHealth")) or 100
            return bandColor(math.clamp(hp / math.max(max, 1), 0, 1))
        end
        return PALETTE[CFG.colorName] or LIGHT_PINK
    end

    local accumulator = 0

    bind(RunService.Heartbeat, function(dt)
        if not Runtime.active then return end
        accumulator = accumulator + dt
        if accumulator < 0.08 then return end
        accumulator = 0

        local seen = {}

        if CFG.enabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = Target.character(player)
                    if char and (not CFG.enemiesOnly or Target.isEnemy(player)) and inRange(char) then
                        local mark = marks[player]
                        if not mark then
                            mark = {}
                            marks[player] = mark
                        end
                        if not mark.hl then
                            mark.hl = mk("Highlight", { Name = "M" }, host)
                        end

                        local color = colorFor(player, char)
                        mark.hl.Adornee = char
                        mark.hl.DepthMode = CFG.throughWalls
                            and Enum.HighlightDepthMode.AlwaysOnTop
                            or Enum.HighlightDepthMode.Occluded
                        mark.hl.FillColor = color
                        mark.hl.OutlineColor = color
                        mark.hl.FillTransparency = 1 - CFG.fill
                        mark.hl.OutlineTransparency = 1 - CFG.outline
                        mark.hl.Enabled = true

                        seen[player] = true
                    end
                end
            end
        end

        for player in pairs(marks) do
            if not seen[player] then drop(player) end
        end
    end)

    bind(Players.PlayerRemoving, drop)

    function Highlight.clear()
        for player in pairs(marks) do drop(player) end
        table.clear(marks)
    end
end

local Tracer = {}
do
    local MAX = 120

    local host = mk("Part", {
        Name = "H",
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        CanTouch = false,
        Transparency = 1,
        Size = Vector3.new(0.05, 0.05, 0.05),
        CFrame = CFrame.new(),
    }, WorldBin)

    local live, pool = {}, {}

    local function build()
        local a0 = mk("Attachment", {}, host)
        local a1 = mk("Attachment", {}, host)
        local beam = mk("Beam", {
            Attachment0 = a0,
            Attachment1 = a1,
            Texture = ASSET.Trace,
            TextureMode = Enum.TextureMode.Wrap,
            TextureLength = 6,
            TextureSpeed = 0,
            Width0 = 0.22,
            Width1 = 0.22,
            FaceCamera = true,
            LightEmission = 1,
            LightInfluence = 0,
            Segments = 1,
        }, host)
        return { a0 = a0, a1 = a1, beam = beam }
    end

    local function release(trace)
        trace.beam.Enabled = false
        pool[#pool + 1] = trace
    end

    function Tracer.fire(origin, target, distance)
        if typeof(origin) ~= "Vector3" or typeof(target) ~= "Vector3" then return end

        local length = (typeof(distance) == "number" and distance > 0.05 and distance < 5000)
            and distance or 400

        local finish
        local reach = target.Magnitude
        local gap = (target - origin).Magnitude
        if reach >= 1e-4 and reach <= 1.001 then
            finish = origin + target.Unit * length
        elseif gap > 0.05 and gap < 5000 then
            finish = target
        else
            return
        end

        if #live >= MAX then
            release(table.remove(live, 1))
        end

        local trace = table.remove(pool) or build()
        trace.a0.Position = origin
        trace.a1.Position = finish
        trace.beam.Color = ColorSequence.new(PALETTE[CFG.traceColor] or LIGHT_BLUE)
        trace.beam.Transparency = NumberSequence.new(0)
        trace.beam.Enabled = true
        trace.born = os.clock()
        trace.life = math.max(CFG.traceTime, 0.1)
        trace.fade = 0
        live[#live + 1] = trace
    end

    bind(RunService.Heartbeat, function()
        for i = #live, 1, -1 do
            local trace = live[i]
            local alpha = (os.clock() - trace.born) / trace.life
            if alpha >= 1 then
                release(trace)
                table.remove(live, i)
            else
                local fade = alpha < 0.65 and 0 or (alpha - 0.65) / 0.35
                if math.abs(fade - trace.fade) > 0.03 then
                    trace.fade = fade
                    trace.beam.Transparency = NumberSequence.new(fade)
                end
            end
        end
    end)
end

local Loadout = {}
do
    local cachedRaw, cachedName, cachedPen

    function Loadout.penetration()
        local raw = LocalPlayer:GetAttribute("CurrentEquipped")
        if type(raw) ~= "string" then return nil end
        if raw ~= cachedRaw then
            cachedRaw, cachedName, cachedPen = raw, nil, nil
            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok and type(decoded) == "table" and type(decoded.Name) == "string" then
                cachedName = decoded.Name
                local weapon = moduleOf(WeaponDb, decoded.Name)
                if weapon and type(weapon.Penetration) == "number" then
                    cachedPen = weapon.Penetration
                end
            end
        end
        return cachedPen, cachedName
    end
end

local Pierce = {}
do
    local MATERIAL_BUDGET = {
        [Enum.Material.Plastic]       = 10,
        [Enum.Material.SmoothPlastic] = 10,
        [Enum.Material.Wood]          = 10,
        [Enum.Material.WoodPlanks]    = 10,
        [Enum.Material.Cardboard]     = 10,
        [Enum.Material.Glass]         = 25,
        [Enum.Material.Fabric]        = 25,
    }
    local VARIANT_BUDGET = { ["Sandy Brick"] = 0, IndoorWall = 0 }
    local MAP_MINIMUM = { Reactor = -1 }

    local PASS = LIGHT_BLUE
    local FAIL = LIGHT_PINK

    local rayIgnore
    do
        local ok, fn = pcall(function()
            return require(Replicated.Components.Common.GetRayIgnore)
        end)
        if ok and type(fn) == "function" then rayIgnore = fn end
    end

    function Pierce.ignore()
        local list = rayIgnore and select(2, pcall(rayIgnore))
        if type(list) ~= "table" then list = {} end
        list[#list + 1] = WorldBin
        return list
    end

    local function applyMapMinimum(budget)
        if budget ~= 0 then return budget end
        local map = workspace:GetAttribute("Map")
        if type(map) ~= "string" then return budget end
        return MAP_MINIMUM[map] or budget
    end

    local function surfaceMaterial(part)
        local model = part.Parent
        if model and model:HasTag("BreakableDoor") then return Enum.Material.Metal end
        return part.Material
    end

    function Pierce.passThrough(part)
        if part.Name == "CollisionCapsule" then return true end
        if part:FindFirstAncestorWhichIsA("Accessory") then return true end
        return part:HasTag("CharacterAccessory")
    end

    function Pierce.budget(part, pen)
        local variant = part.MaterialVariant
        if variant ~= "" and VARIANT_BUDGET[variant] ~= nil then
            return applyMapMinimum(VARIANT_BUDGET[variant]) + pen, variant
        end
        local material = surfaceMaterial(part)
        return applyMapMinimum(MATERIAL_BUDGET[material] or 0) + pen, material.Name
    end

    local depthParams = RaycastParams.new()
    depthParams.FilterType = Enum.RaycastFilterType.Include
    depthParams.CollisionGroup = "Bullet"

    function Pierce.thickness(entry, unit, part)
        depthParams.FilterDescendantsInstances = { part }
        local far = entry + unit * 1000
        local result = workspace:Raycast(far, entry - far, depthParams)
        if not result then return nil end
        return (entry - result.Position).Magnitude
    end

    local plate, edge

    local function marker()
        if plate and plate.Parent then return plate, edge end
        plate = mk("Part", {
            Name = "WB",
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CanTouch = false,
            CastShadow = false,
            Material = Enum.Material.Neon,
            Transparency = 1,
            TopSurface = Enum.SurfaceType.Smooth,
            BottomSurface = Enum.SurfaceType.Smooth,
        }, WorldBin)
        edge = mk("Highlight", {
            Name = "Edge",
            Adornee = plate,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            FillTransparency = 1,
            OutlineTransparency = 0,
            Enabled = false,
        }, plate)
        return plate, edge
    end

    local drawn = false

    local function hide()
        if plate then plate.Transparency = 1 end
        if edge then edge.Enabled = false end
        drawn = false
    end

    local shotParams = RaycastParams.new()
    shotParams.FilterType = Enum.RaycastFilterType.Exclude
    shotParams.IgnoreWater = false
    shotParams.CollisionGroup = "Bullet"

    bind(RunService.RenderStepped, function()
        if not (Runtime.active and CFG.wallbang) then
            if drawn then hide() end
            return
        end

        local pen = Loadout.penetration()
        if not pen then return hide() end

        local camera = workspace.CurrentCamera
        if not camera then return hide() end

        local viewport = camera.ViewportSize
        local ray = camera:ViewportPointToRay(viewport.X * 0.5, viewport.Y * 0.5)
        local unit = ray.Direction.Unit

        shotParams.FilterDescendantsInstances = Pierce.ignore()

        local hit
        for _ = 1, 8 do
            local result = workspace:Raycast(ray.Origin, unit * 1200, shotParams)
            if not result then break end
            if not Pierce.passThrough(result.Instance) then
                hit = result
                break
            end
            shotParams:AddToFilter(result.Instance)
        end
        if not hit or hit.Instance:IsDescendantOf(Characters) then return hide() end

        local thickness = Pierce.thickness(hit.Position, unit, hit.Instance)
        local budget = Pierce.budget(hit.Instance, pen)
        local punches = thickness ~= nil and thickness <= budget

        pcall(function()
            local size = CFG.wbSize
            local color = punches and PASS or FAIL
            local body, outline = marker()
            body.Size = Vector3.new(size, size, 0.05)
            body.CFrame = CFrame.lookAlong(hit.Position + hit.Normal * 0.03, hit.Normal)
            body.Color = color
            body.Transparency = CFG.wbAlpha
            outline.OutlineColor = color
            outline.Enabled = true
            drawn = true
        end)
    end)
end

local Impacts = {}
do
    local MAX = 80
    local FILL = 0.7

    local live, pool = {}, {}

    local aimParams = RaycastParams.new()
    aimParams.FilterType = Enum.RaycastFilterType.Exclude
    aimParams.IgnoreWater = false
    aimParams.CollisionGroup = "Bullet"

    local function build()
        local cube = mk("Part", {
            Name = "I",
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CanTouch = false,
            CastShadow = false,
            Material = Enum.Material.Neon,
            Shape = Enum.PartType.Block,
            Size = Vector3.new(0.3, 0.3, 0.3),
            Transparency = 1,
            TopSurface = Enum.SurfaceType.Smooth,
            BottomSurface = Enum.SurfaceType.Smooth,
        }, WorldBin)
        mk("Highlight", {
            Name = "Edge",
            Adornee = cube,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            FillTransparency = 1,
            OutlineTransparency = 0,
            Enabled = false,
        }, cube)
        return cube
    end

    local function release(cube)
        cube.Transparency = 1
        cube.Edge.Enabled = false
        pool[#pool + 1] = cube
    end

    local function place(position, color)
        if #live >= MAX then
            release(table.remove(live, 1))
        end
        local cube = table.remove(pool) or build()
        cube.Position = position
        cube.Color = color
        cube.Transparency = FILL
        cube.Edge.OutlineColor = color
        cube.Edge.Enabled = true
        live[#live + 1] = {
            cube = cube,
            born = os.clock(),
            life = math.clamp(tonumber(CFG.biTime) or 1.5, 0.5, 5),
        }
    end

    local function aimPoint()
        local camera = workspace.CurrentCamera
        if not camera then return nil end
        local viewport = camera.ViewportSize
        local ray = camera:ViewportPointToRay(viewport.X * 0.5, viewport.Y * 0.5)
        aimParams.FilterDescendantsInstances = Pierce.ignore()
        for _ = 1, 8 do
            local result = workspace:Raycast(ray.Origin, ray.Direction.Unit * 2000, aimParams)
            if not result then return nil end
            if not Pierce.passThrough(result.Instance) then return result.Position end
            aimParams:AddToFilter(result.Instance)
        end
        return nil
    end

    function Impacts.record(hits)
        local mode = CFG.biMode
        local landed
        local last = hits[#hits]
        if last and typeof(last.Position) == "Vector3" then landed = last.Position end
        local aimed = aimPoint()
        if landed and mode ~= "Client" then place(landed, LIGHT_PINK) end
        if aimed and mode ~= "Server" then place(aimed, LIGHT_BLUE) end
        Runtime.gap = (landed and aimed) and (landed - aimed).Magnitude or nil
    end

    bind(RunService.Heartbeat, function()
        for i = #live, 1, -1 do
            local entry = live[i]
            if os.clock() - entry.born >= entry.life then
                release(entry.cube)
                table.remove(live, i)
            end
        end
        Runtime.impacts = #live
    end)
end

local Sky = {}
do
    local PHASES = {
        { "Night", 0 }, { "Dawn", 6 }, { "Morning", 9 },
        { "Noon", 12 }, { "Afternoon", 16 }, { "Dusk", 19 },
    }

    Sky.names, Sky.hours = {}, {}
    for _, phase in ipairs(PHASES) do
        Sky.names[#Sky.names + 1] = phase[1]
        Sky.hours[phase[1]] = phase[2]
    end

    function Sky.phaseOf(hour)
        hour = hour % 24
        if hour < 5 or hour >= 21 then return "Night" end
        if hour < 8 then return "Dawn" end
        if hour < 11 then return "Morning" end
        if hour < 14 then return "Noon" end
        if hour < 18 then return "Afternoon" end
        return "Dusk"
    end

    local FIELDS = {
        "ClockTime", "Brightness", "ExposureCompensation", "Ambient",
        "OutdoorAmbient", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
    }

    local snapshot = {}
    for _, field in ipairs(FIELDS) do
        snapshot[field] = Lighting[field]
    end

    local baseName, baseValues

    local function base()
        local name = tostring(workspace:GetAttribute("Map"))
        if name ~= baseName then
            local map = moduleOf(MapDb, name)
            local props = (map and type(map.Lighting) == "table" and map.Lighting.Properties) or {}
            baseValues = {}
            for _, field in ipairs(FIELDS) do
                baseValues[field] = props[field] or snapshot[field]
            end
            baseName = name
        end
        return baseValues
    end

    local applied = false

    function Sky.restore()
        local values = base()
        for _, field in ipairs(FIELDS) do
            Lighting[field] = values[field]
        end
        applied = false
    end

