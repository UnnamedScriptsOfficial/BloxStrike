local Spread = {}
do
    local SNIPER_FLOOR = { [2] = 6, [3] = 12 }

    local inventory = moduleOf(Replicated:WaitForChild("Controllers"), "InventoryController")

    function Spread.degrees()
        if not inventory or type(inventory.peekCurrentEquippedForMovement) ~= "function" then
            return nil
        end

        local ok, weapon = pcall(inventory.peekCurrentEquippedForMovement)
        if not ok or type(weapon) ~= "table" or type(weapon.getSpread) ~= "function" then
            return nil
        end

        local props = weapon.Properties
        local sniper = type(props) == "table" and props.AimingOptions == "SniperScope"
        local aiming = weapon.IsAiming == true

        local spread
        if sniper and type(weapon.Bullet) == "table" then
            local bullet = weapon.Bullet
            local config = bullet.ActiveSpreadConfig
                or (type(bullet.Properties) == "table" and bullet.Properties.Spread)
            local multiplier = (type(config) == "table" and config.MovementMultiplier) or 1
            local floor = SNIPER_FLOOR[multiplier] or 15

            if not aiming then
                local okBase, resting = pcall(bullet.getBaseSpreadForConfig, bullet, config)
                local okMove, moving = pcall(bullet.getMovementSpreadForConfig, bullet, config)
                if okBase and okMove and type(resting) == "number" and type(moving) == "number" then
                    spread = math.max(resting, floor) + moving
                end
            elseif weapon.Name == "AWP"
                and (tick() - (tonumber(weapon.ScopeStartTick) or 0)) < 0.2
            then
                local okTrue, value = pcall(bullet.getTrueSpread, bullet)
                if okTrue and type(value) == "number" then
                    spread = math.max(value, floor)
                end
            end
        end

        if spread == nil then
            local okSpread, value = pcall(weapon.getSpread, weapon)
            if not okSpread or type(value) ~= "number" then return nil end
            spread = value
        end

        return spread, weapon, aiming
    end
end

