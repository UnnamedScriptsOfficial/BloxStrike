local SCREENS = {
    "Dashboard", "GameDashboard", "Inventory", "Loadout", "Gamemodes",
    "Settings", "Store", "Career", "Progression", "GlobalMarketPlace",
}

local open = false
local stash = {}

local function anyScreenUp()
    for _, name in ipairs(SCREENS) do
        local screen = Menu:FindFirstChild(name)
        if screen and screen:IsA("GuiObject") and screen.Visible then return true end
    end
    return false
end

local function setOpen(value)
    open = value and true or false

    if open then
        table.clear(stash)
        for _, name in ipairs(SCREENS) do
            local screen = Menu:FindFirstChild(name)
            if screen and screen:IsA("GuiObject") and screen.Visible then
                stash[#stash + 1] = screen
                screen.Visible = false
            end
        end
    elseif #stash > 0 then
        local hidden = stash
        stash = {}
        task.defer(function()
            if anyScreenUp() then return end
            for _, screen in ipairs(hidden) do
                if screen.Parent then screen.Visible = true end
            end
        end)
    end

    panel.Visible = open
end

bind(navButton.Activated, function() setOpen(not open) end)

for _, holder in ipairs({ NavBar:FindFirstChild("Top"), NavBar:FindFirstChild("Bottom") }) do
    local box = holder and holder:FindFirstChild("Buttons")
    if box then
        for _, button in ipairs(box:GetChildren()) do
            if button:IsA("GuiButton") and button ~= navButton then
                bind(button.Activated, function() setOpen(false) end)
            end
        end
    end
end

