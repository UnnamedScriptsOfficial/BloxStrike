_G.BSHL_UNLOAD = function()
    Runtime.active = false

    CFG.enabled = false
    CFG.bulletTrace = false
    CFG.hitSound = false
    CFG.autoBhop = false
    CFG.wallbang = false
    CFG.spreadCircle = false
    CFG.worldLight = false
    CFG.bombInfo = false
    CFG.bulletImpacts = false
    CFG.triggerbot = false

    pcall(Sky.restore)
    pcall(setOpen, false)
    pcall(Bhop.release)

    ShotFeed.restore()
    Bhop.restore()

    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    Highlight.clear()
    for _, instance in ipairs(owned) do
        pcall(function() instance:Destroy() end)
    end

    table.clear(connections)
    _G.BSHL_UNLOAD = nil
    _G.BSHL = nil
end

