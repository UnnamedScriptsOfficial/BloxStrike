do
    local CONE_THETAS = 6
    local CONE_RINGS = { 0.125, 0.375, 0.625, 0.875 }
    local CONE_STEP = 2 * math.pi / CONE_THETAS
    local PROBE_STEPS = 12
    local DAMAGE_UNIT = 75

    local GROUP = {
        Head = "Head",
        UpperTorso = "Torso", LowerTorso = "Torso", HumanoidRootPart = "Torso",
        LeftUpperArm = "Arms", LeftLowerArm = "Arms", LeftHand = "Arms",
        RightUpperArm = "Arms", RightLowerArm = "Arms", RightHand = "Arms",
        LeftUpperLeg = "Legs", LeftLowerLeg = "Legs", LeftFoot = "Legs",
        RightUpperLeg = "Legs", RightLowerLeg = "Legs", RightFoot = "Legs",
    }

    local armor = setmetatable({}, { __mode = "k" })

    local function armoured(player, group)
        if group == "Legs" then return false end
        local raw = player:GetAttribute("Armor")
        if type(raw) ~= "string" then return false end
        local entry = armor[player]
        if entry == nil or entry.raw ~= raw then
            entry = { raw = raw, vest = false, helmet = false }
            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok and type(decoded) == "table" and (tonumber(decoded.Health) or 0) > 0 then
                entry.vest = true
                entry.helmet = type(decoded.Type) == "string"
                    and string.find(decoded.Type, "Helmet") ~= nil
            end
            armor[player] = entry
        end
        if group == "Head" then return entry.helmet end
        return entry.vest
    end

    local function estimate(props, part, player, distance, walls)
        if type(props) ~= "table" or type(props.DamagePerPart) ~= "table" then return nil end
        local group = GROUP[part.Name]
        if group == nil then return nil end
        local value = tonumber(props.DamagePerPart[group])
        if not value then return nil end
        local falloff = tonumber(props.RangeModifier)
        if falloff and falloff > 0 and falloff < 1 then
            value = value * falloff ^ (distance / DAMAGE_UNIT)
        end
        if armoured(player, group) then
            value = value * (tonumber(props.ArmorPenetration) or 1)
        end
        if walls > 0 then
            value = value * (tonumber(props.WallbangMultiplier) or 1) ^ walls
        end
        return value
    end

    local function deflect(dir, theta, phi)
        local unit = dir.Magnitude > 0 and dir.Unit or Vector3.new(0, 0, 1)
        local up = math.abs(unit.Y) > 0.9999 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
        local base = CFrame.lookAlong(Vector3.new(0, 0, 0), unit, up)
        return (base * CFrame.Angles(0, 0, theta) * CFrame.Angles(phi, 0, 0)).LookVector
    end

    local function victim(instance)
        local headshot = Target.classify(instance)
        if headshot == nil then return nil end
        local player = Players:GetPlayerFromCharacter(instance.Parent)
        if not player then return nil end
        if CFG.tbEnemies and not Target.isEnemy(player) then return nil end
        return headshot, player
    end

    local probeParams = RaycastParams.new()
    probeParams.FilterType = Enum.RaycastFilterType.Exclude
    probeParams.IgnoreWater = false
    probeParams.CollisionGroup = "Bullet"

    local function probe(origin, dir, range, ignore, props, wall)
        probeParams.FilterDescendantsInstances = ignore
        local pen = wall and (tonumber(props.Penetration) or 0) or 0
        local used, walls = nil, 0
        for _ = 1, PROBE_STEPS do
            local result = workspace:Raycast(origin, dir * range, probeParams)
            if not result then return nil end
            local instance = result.Instance
            if not Pierce.passThrough(instance) then
                local headshot, player = victim(instance)
                if headshot ~= nil then
                    return headshot, estimate(props, instance, player, result.Distance, walls), walls
                end
                if not wall then return nil end
                if instance:IsDescendantOf(Characters) then return nil end
                local budget, key = Pierce.budget(instance, pen)
                local thick = Pierce.thickness(result.Position, dir, instance)
                if thick == nil then return nil end
                used = used or {}
                local total = (used[key] or 0) + thick
                if total > budget then return nil end
                used[key] = total
                walls = walls + 1
            end
            probeParams:AddToFilter(instance)
        end
        return nil
    end

    local press, release
    do
        local function global(name)
            local ok, value = pcall(function()
                if getgenv then return getgenv()[name] end
                return nil
            end)
            if ok and type(value) == "function" then return value end
            local okLocal, localValue = pcall(function() return _G[name] end)
            if okLocal and type(localValue) == "function" then return localValue end
            return nil
        end
        press, release = global("mouse1press"), global("mouse1release")
        if not (press and release) then
            local ok, virtual = pcall(game.GetService, game, "VirtualInputManager")
            if ok and virtual then
                local function send(down)
                    local camera = workspace.CurrentCamera
                    local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
                    virtual:SendMouseButtonEvent(viewport.X * 0.5, viewport.Y * 0.5, 0, down, game, false)
                end
                press = function() send(true) end
                release = function() send(false) end
            end
        end
    end

    local armedAt
    local firing = false

    local function idle(reason)
        armedAt = nil
        Runtime.chance, Runtime.guard, Runtime.part, Runtime.reason = 0, false, nil, reason
        Runtime.damage, Runtime.walls = 0, 0
    end

    local function hold(reason)
        armedAt = nil
        Runtime.reason = reason
    end

    bind(RunService.RenderStepped, function()
        if not (Runtime.active and CFG.triggerbot) then
            if armedAt ~= nil or Runtime.reason ~= nil or Runtime.part ~= nil then
                idle(nil)
                Runtime.spread = nil
            end
            return
        end

        if Menu.Visible then return idle("menu open") end
        if LocalPlayer:GetAttribute("IsPlayerChatting") then return idle("typing") end
        if not Target.character(LocalPlayer) then return idle("not alive") end
        if not (press and release) then return idle("no input method") end
        if UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            return idle("manual fire")
        end

        local spread, weapon = Spread.degrees()
        Runtime.spread = spread
        if not spread then return idle("no weapon") end
        if type(weapon.Bullet) ~= "table" then return idle("not a gun") end
        local rounds = tonumber(weapon.Rounds)
        if rounds and rounds <= 0 then return idle("empty") end
        if weapon.IsReloading == true then return idle("reloading") end

        local camera = workspace.CurrentCamera
        if not camera then return idle("no camera") end
        local viewport = camera.ViewportSize
        local ray = camera:ViewportPointToRay(viewport.X * 0.5, viewport.Y * 0.5)
        local dir = ray.Direction.Magnitude > 0 and ray.Direction.Unit or Vector3.new(0, 0, 1)

        local props = type(weapon.Bullet.Properties) == "table" and weapon.Bullet.Properties or nil
        local range = (props and tonumber(props.Range)) or 500
        local wall = CFG.tbWall and props ~= nil
        local floor = tonumber(CFG.tbMinDmg) or 0
        local ignore = Pierce.ignore()

        local headshot, damage, walls = probe(ray.Origin, dir, range, ignore, props, wall)
        if headshot == nil then return idle("no target") end
        if not Target.wants(CFG.tbWhere, headshot) then return idle("wrong part") end
        Runtime.part = headshot and "HEAD" or "BODY"
        Runtime.damage, Runtime.walls = damage or 0, walls

        if walls > 0 and damage and damage < floor then
            Runtime.chance, Runtime.guard = 0, false
            return hold("weak wallbang")
        end

        local maxPhi = math.rad(math.min(spread, 69) * 0.5)
        local chance, guard

        local function lands(candidate)
            local hit, value, crossed = probe(ray.Origin, candidate, range, ignore, props, wall)
            if hit == nil or not Target.wants(CFG.tbWhere, hit) then return false end
            if crossed > 0 and value and value < floor then return false end
            return true
        end

        if maxPhi <= 0 then
            chance, guard = 1, true
        else
            local pass, total = 0, 0
            for index, fraction in ipairs(CONE_RINGS) do
                local phi = maxPhi * fraction
                local offset = (index - 1) * CONE_STEP / #CONE_RINGS
                for k = 1, CONE_THETAS do
                    total = total + 1
                    if lands(deflect(dir, offset + (k - 1) * CONE_STEP, phi)) then
                        pass = pass + 1
                    end
                end
            end
            chance = total > 0 and pass / total or 0

            guard = (pass == total)
            if guard then
                local rim = CONE_THETAS * 2
                local rimStep = 2 * math.pi / rim
                for k = 1, rim do
                    if not lands(deflect(dir, (k - 1) * rimStep, maxPhi)) then
                        guard = false
                        break
                    end
                end
            end
        end

        Runtime.chance, Runtime.guard = chance, guard
        if chance < 0.5 then return hold("low chance") end

        local now = os.clock()
        if armedAt == nil then armedAt = now end
        local wait = (tonumber(CFG.tbDelay) or 0) / 1000
        if now - armedAt < wait then
            Runtime.reason = string.format("armed %dms", math.floor((now - armedAt) * 1000 + 0.5))
            return
        end
        Runtime.reason = nil
        if firing then return end

        firing = true
        armedAt = nil
        Runtime.shots = Runtime.shots + 1
        task.spawn(function()
            pcall(press)
            pcall(function()
                RunService.RenderStepped:Wait()
                RunService.RenderStepped:Wait()
            end)
            pcall(release)
            firing = false
        end)
    end)
end

