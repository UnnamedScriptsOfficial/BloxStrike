        if child:IsA("GuiObject") and child ~= sourceTab then child:Destroy() end
    end
    TPL.tab = sourceTab:Clone()
    sourceTab:Destroy()
end

do
    local function near(a, b)
        return math.abs(a.R - b.R) < 0.02
            and math.abs(a.G - b.G) < 0.02
            and math.abs(a.B - b.B) < 0.02
    end

    for _, child in ipairs(SettingsPane.Top.Categories:GetChildren()) do
        local title = child:IsA("GuiObject") and child:FindFirstChild("Title")
        if title and title:IsA("TextLabel") then
            if near(child.BackgroundColor3, TAB.On) then
                TAB.TextOn = title.TextColor3
            else
                TAB.TextOff = title.TextColor3
            end
        end
    end
end

local repaint = {}
local catalog = {}

local function refresh(key)
    if key then
        if repaint[key] then repaint[key]() end
        return
    end
    for _, fn in pairs(repaint) do pcall(fn) end
end

local function selectTab(name)
    for _, entry in ipairs(catalog) do
        local on = entry.name == name
        entry.page.Visible = on
        entry.tab.BackgroundColor3 = on and TAB.On or TAB.Off
        if entry.title then
            entry.title.TextColor3 = on and TAB.TextOn or TAB.TextOff
        end
    end
end

local function shapeBar(bar, count)
    for _, child in ipairs(bar:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    for index = 1, count do
        local segment = TPL.segment:Clone()
        segment.Name = tostring(index)
        segment.LayoutOrder = index
        segment.Size = UDim2.new(1 / count, -3, 1, 0)
        segment.BackgroundColor3 = SWITCH.Dim
        segment.Parent = bar
    end
end

local function paintBar(bar, count, isLit)
    for index = 1, count do
        local segment = bar:FindFirstChild(tostring(index))
        if segment then
            segment.BackgroundColor3 = isLit(index) and SWITCH.Lit or SWITCH.Dim
        end
    end
end

local Page = {}
Page.__index = Page

function Page.new(name, caption, heading, blurb)
    local page = TPL.page:Clone()
    page.Name = name
    page.Visible = false
    page.Header.Heading.Header.Text = heading
    page.Header.Title.Text = blurb
    page.Parent = pageBox

    local scroll = page.Bottom.Scroll
    mk("Frame", {
        Name = "Tail",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, TAIL),
        LayoutOrder = 10000,
    }, scroll)

    local tab = TPL.tab:Clone()
    tab.Name = name
    tab.LayoutOrder = #catalog + 1
    tab.Visible = true
    tab.Parent = tabBox

    local title = tab:FindFirstChild("Title")
    if not (title and title:IsA("TextLabel")) then
        title = tab:FindFirstChildWhichIsA("TextLabel", true)
    end
    if title then title.Text = caption end

    bind(tab.Activated, function() selectTab(name) end)

    local self = setmetatable({
        name = name, page = page, tab = tab, title = title,
        scroll = scroll, order = 0,
    }, Page)

    catalog[#catalog + 1] = self
    return self
end

function Page:next()
    self.order = self.order + 1
    return self.order
end

function Page:section(text)
    local label = TPL.section:Clone()
    label.Name = "S_" .. text
    label.Text = text
    label.LayoutOrder = self:next()
    label.Parent = self.scroll
    return label
end

function Page:divider()
    local line = TPL.divider:Clone()
    line.LayoutOrder = self:next()
    line.Parent = self.scroll
    return line
end

function Page:widget(text)
    local row = TPL.row:Clone()
    row.Name = text
    row.Left.Label.Text = text
    row.LayoutOrder = self:next()
    row.Parent = self.scroll
    local switch = row.Right.Switch
    return row, switch, switch.Selection.Title, switch.Selection.Frame
end

function Page:toggle(key, text)
    local row, switch, title, bar = self:widget(text)
    shapeBar(bar, 2)

    local function paint()
        local on = CFG[key] and true or false
        title.Text = on and "ON" or "OFF"
        paintBar(bar, 2, function(index) return (index == 2) == on end)
    end

    local function flip()
        CFG[key] = not CFG[key]
        paint()
    end

    bind(switch.Left.Activated, flip)
    bind(switch.Right.Activated, flip)
    bind(switch.Activated, flip)

    repaint[key] = paint
    paint()
    self:divider()
    return row
end

function Page:choice(key, text, options)
    local row, switch, title, bar = self:widget(text)
    local count = #options
    shapeBar(bar, count)

    local function indexOf()
        for index, option in ipairs(options) do
            if option == CFG[key] then return index end
        end
        return 1
    end

    local function paint()
        local index = indexOf()
        title.Text = string.upper(options[index])
        paintBar(bar, count, function(slot) return slot == index end)
    end

    local function step(delta)
        CFG[key] = options[((indexOf() - 1 + delta) % count) + 1]
        paint()
    end

    bind(switch.Left.Activated, function() step(-1) end)
    bind(switch.Right.Activated, function() step(1) end)
    bind(switch.Activated, function() step(1) end)

    repaint[key] = paint
    paint()
    self:divider()
    return row
end

function Page:slider(key, text, min, max, stepBy, format, segments)
    segments = segments or 10
    local row, switch, title, bar = self:widget(text)
    shapeBar(bar, segments)

    local function paint()
        local value = CFG[key]
        title.Text = format(value)
        local lit = math.floor(((value - min) / (max - min)) * segments + 0.5)
        if lit < 1 and min > 0 then lit = 1 end
        paintBar(bar, segments, function(index) return index <= lit end)
    end

    local function step(delta)
        local value = CFG[key] + delta * stepBy
        CFG[key] = math.clamp(math.floor(value / stepBy + 0.5) * stepBy, min, max)
        paint()
    end

    bind(switch.Left.Activated, function() step(-1) end)
    bind(switch.Right.Activated, function() step(1) end)

    repaint[key] = paint
    paint()
    self:divider()
    return row
end

function Page:list(key, text, values, format)
    local row, switch, title, bar = self:widget(text)
    local count = #values
    shapeBar(bar, count)

    local function indexOf()
        for index, value in ipairs(values) do
            if value == CFG[key] then return index end
        end
        return 1
    end

    local function paint()
        local index = indexOf()
        title.Text = format(values[index])
        paintBar(bar, count, function(slot) return slot <= index end)
    end

    local function step(delta)
        CFG[key] = values[math.clamp(indexOf() + delta, 1, count)]
        paint()
    end

    bind(switch.Left.Activated, function() step(-1) end)
    bind(switch.Right.Activated, function() step(1) end)

    repaint[key] = paint
    paint()
    self:divider()
    return row
end

function Page:pad()
    local scroll = self.scroll
    local tail = scroll:FindFirstChild("Tail")
    local layout = scroll:FindFirstChildWhichIsA("UIListLayout")
    if not (tail and layout) then return end
    for _ = 1, 4 do
        task.wait()
        local rows = layout.AbsoluteContentSize.Y - tail.AbsoluteSize.Y
        tail.Size = UDim2.new(1, 0, 0,
            math.floor(math.max(TAIL, scroll.AbsoluteSize.Y + TAIL - rows)))
    end
end

