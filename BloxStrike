local connections, owned = {}, {}

local function bind(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end

local function own(instance)
    owned[#owned + 1] = instance
    return instance
end

local function mk(class, props, parent)
    local instance = Instance.new(class)
    for key, value in pairs(props) do
        instance[key] = value
    end
    if parent then instance.Parent = parent end
    return instance
end

local function suffix(prefix)
    return prefix .. tostring(math.random(100000, 999999))
end

local function moduleOf(container, name)
    local child = name and container:FindFirstChild(tostring(name))
    if not (child and child:IsA("ModuleScript")) then return nil end
    local ok, value = pcall(require, child)
    if not ok or type(value) ~= "table" then return nil end
    return value
end

